PORT=2110

# Database
MONGOOSE_URL=mongodb://localhost:27017/aurajewels-db

# Authentication Secrets
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
ACCESS_TOKEN_TTL=1h

# Client URLs
FRONTEND_URL_ADMIN=http://localhost:3001/
FRONTEND_URL=http://localhost:3000/
APP_URL=/
DEVELOPER_MODE=true

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_SECURE=false
SMTP_FROM="Aura Jewels <noreply@aurajewels.com>"
SUPPORT_EMAIL=support@aurajewels.com
ADMIN_NOTIFY_EMAIL=admin@aurajewels.com
EMAIL_ASSET_BASE_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 Storage (Optional)
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_UPLOAD_PATH=

# Security & OTP
SMS_ENC_KEY=your_32_char_encryption_key_here
OTP_TEST_MODE=true

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY=rzp_test_yourKeyHere
RAZORPAY_SECRET_KEY=yourSecretKeyHere
